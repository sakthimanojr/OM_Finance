generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  VIEW_ADMIN
  CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DocumentType {
  AADHAAR
  PAN
  AGREEMENT
  OTHER
}

enum LoanType {
  WEEKLY
  MONTHLY
  HIGH_VALUE
}

enum LoanStatus {
  ACTIVE
  COMPLETED
  CLOSED
  OVERDUE
}

enum DueStatus {
  PENDING
  PAID
  MISSED
}

enum PaymentMethod {
  UPI
  CASH
  BANK_TRANSFER
  MANUAL
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String   @id @default(uuid())
  role         Role
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer  Customer?
  auditLogs AuditLog[]

  // Chit Fund relations
  chitFundsCreated   ChitFund[]           @relation("ChitFundCreatedBy")
  chitMemberships    ChitMember[]         @relation("ChitMemberUser")
  chitAuctionsCreated ChitAuction[]       @relation("ChitAuctionCreatedBy")
  chitLedgerEntries  ChitFundLedger[]     @relation("ChitLedgerCreatedBy")
  chitLoansCreated   ChitLoan[]           @relation("ChitLoanCreatedBy")
  chitLoanTxCreated  ChitLoanTransaction[] @relation("ChitLoanTxCreatedBy")

  @@map("users")
}

model Customer {
  id               String         @id @default(uuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  fatherName       String?
  phone            String
  email            String?
  address          String?
  aadhaarLast4     String?
  aadhaarEncrypted String?
  panEncrypted     String?
  occupation       String?
  monthlyIncome    Decimal?       @db.Decimal(12, 2)
  guarantorName    String?
  guarantorPhone   String?
  emergencyContact String?
  photoUrl         String?
  status           CustomerStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  documents     Document[]
  loans         Loan[]
  payments      Payment[]
  notifications Notification[]

  // Chit Fund relations
  chitMemberships ChitMember[] @relation("ChitMemberCustomer")

  @@map("customers")
}

model Document {
  id                 String       @id @default(uuid())
  customerId         String
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type               DocumentType
  fileUrl            String
  cloudinaryPublicId String?
  uploadedAt         DateTime     @default(now())

  @@map("documents")
}

model Loan {
  id               String     @id @default(uuid())
  customerId       String
  customer         Customer   @relation(fields: [customerId], references: [id])
  loanNumber       String     @unique
  type             LoanType
  principal        Decimal    @db.Decimal(12, 2)
  interestRate     Decimal    @db.Decimal(5, 2)
  agreementFee     Decimal    @default(0) @db.Decimal(10, 2)
  disbursedAmount  Decimal    @db.Decimal(12, 2)
  totalCollection  Decimal    @default(0) @db.Decimal(12, 2)
  startDate        DateTime
  endDate          DateTime?
  status           LoanStatus @default(ACTIVE)
  termCount        Int?
  installmentAmount Decimal?  @db.Decimal(12, 2)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  dues     Due[]
  payments Payment[]

  @@map("loans")
}

model Due {
  id          String    @id @default(uuid())
  loanId      String
  loan        Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  dueNumber   Int
  dueDate     DateTime
  amount      Decimal   @db.Decimal(12, 2)
  status      DueStatus @default(PENDING)
  paidDate    DateTime?
  paidAmount  Decimal?  @db.Decimal(12, 2)
  paymentMethod PaymentMethod?
  remarks     String?
  createdAt   DateTime  @default(now())

  payments Payment[]

  @@unique([loanId, dueNumber])
  @@map("dues")
}

model Payment {
  id            String        @id @default(uuid())
  dueId         String
  due           Due           @relation(fields: [dueId], references: [id])
  loanId        String
  loan          Loan          @relation(fields: [loanId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  upiRefNumber  String?
  gatewayOrderId String?      @unique
  gatewaySignature String?
  status        PaymentStatus @default(INITIATED)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  receipt Receipt?

  @@map("payments")
}

model Receipt {
  id                 String   @id @default(uuid())
  paymentId          String   @unique
  payment            Payment  @relation(fields: [paymentId], references: [id])
  receiptNumber      String   @unique
  billNumber         Int      @default(autoincrement()) @unique
  qrCodeUrl          String?
  pdfUrl             String?
  cloudinaryPublicId String?
  generatedAt        DateTime @default(now())

  @@map("receipts")
}

model Notification {
  id         String              @id @default(uuid())
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id])
  channel    NotificationChannel
  type       String
  message    String
  sentAt     DateTime?
  status     NotificationStatus  @default(PENDING)
  createdAt  DateTime            @default(now())

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model AdminConfig {
  id                String   @id @default(uuid())
  upiId             String?
  smsProvider       String?
  smsApiKeyEncrypted String?
  smtpConfigEncrypted String?
  updatedBy         String?
  updatedAt         DateTime @updatedAt

  @@map("admin_config")
}

model ClosedLoan {
  id              String   @id @default(uuid())
  loanId          String   @unique
  customerId      String
  customerName    String
  customerPhone   String
  loanType        String
  loanNumber      String?
  principal       Decimal  @db.Decimal(12, 2)
  interestRate    Decimal  @db.Decimal(5, 2)
  disbursedAmount Decimal  @db.Decimal(12, 2)
  totalCollected  Decimal  @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime?
  closedAt        DateTime @default(now())
  paymentHistory  Json
  dueSchedule     Json

  @@map("closed_loans")
}

// ─────────────────────────────────────────────
// CHIT FUND MODULE
// ─────────────────────────────────────────────

enum ChitStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum ChitMemberStatus {
  ACTIVE
  INACTIVE
  REMOVED
}

enum ChitMonthStatus {
  OPEN
  CLOSED
}

enum AuctionType {
  REGULAR
  ADDITIONAL
}

enum AuctionStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum ChitMemberPaymentStatus {
  PENDING
  PARTIAL
  PAID
  LATE
  FAILED
  WAIVED
}

enum ChitLoanStatus {
  ACTIVE
  PARTIALLY_PAID
  PAID
  OVERDUE
  WRITTEN_OFF
}

enum ChitLedgerDirection {
  CREDIT
  DEBIT
}

enum ChitLedgerTransactionType {
  WINNING_BID_CREDIT
  LOAN_DISBURSEMENT
  LOAN_PRINCIPAL_REPAYMENT
  LOAN_INTEREST_CREDIT
  ADDITIONAL_AUCTION_ALLOCATION
  MANUAL_CREDIT
  MANUAL_DEBIT
  REFUND
}

model ChitFund {
  id                   String     @id @default(uuid())
  name                 String
  description          String?
  memberCount          Int
  monthlyContribution  Decimal    @db.Decimal(15, 2)
  regularAuctionAmount Decimal    @db.Decimal(15, 2)
  startingBid          Decimal    @db.Decimal(15, 2)
  interestRate         Decimal    @default(3.00) @db.Decimal(5, 2)
  loanPeriodRule       String?    // e.g. "repay before next auction"
  startDate            DateTime
  paymentDueDay        Int        @default(1) // day of month payment is due
  currentMonth         Int        @default(0)
  completedAuctionCount Int       @default(0)
  requiredWinnerCount  Int        // = memberCount
  status               ChitStatus @default(DRAFT)
  createdById          String
  createdBy            User       @relation("ChitFundCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  members      ChitMember[]
  months       ChitMonth[]
  auctions     ChitAuction[]
  loans        ChitLoan[]
  ledger       ChitFundLedger[]
  payments     ChitMemberPayment[]
  payouts      ChitPayout[]

  @@map("chit_funds")
}

model ChitMember {
  id                  String           @id @default(uuid())
  chitId              String
  chit                ChitFund         @relation(fields: [chitId], references: [id], onDelete: Cascade)
  userId              String
  user                User             @relation("ChitMemberUser", fields: [userId], references: [id])
  customerId          String
  customer            Customer         @relation("ChitMemberCustomer", fields: [customerId], references: [id])
  monthlyContribution Decimal          @db.Decimal(15, 2)
  auctionEligible     Boolean          @default(true)
  hasWonAuction       Boolean          @default(false)
  wonAuctionId        String?          // Denormalized ref – enforced by app logic
  wonAuctionNumber    Int?
  status              ChitMemberStatus @default(ACTIVE)
  joinedAt            DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  payments       ChitMemberPayment[]
  loans          ChitLoan[]
  payouts        ChitPayout[]
  wonAuctions    ChitAuction[]    @relation("AuctionWinner")

  @@unique([chitId, userId])
  @@map("chit_members")
}

model ChitMonth {
  id              String          @id @default(uuid())
  chitId          String
  chit            ChitFund        @relation(fields: [chitId], references: [id], onDelete: Cascade)
  monthNumber     Int
  periodStart     DateTime
  periodEnd       DateTime?
  amountDue       Decimal         @db.Decimal(15, 2)
  amountCollected Decimal         @default(0) @db.Decimal(15, 2)
  status          ChitMonthStatus @default(OPEN)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  auctions ChitAuction[]
  payments ChitMemberPayment[]

  @@unique([chitId, monthNumber])
  @@map("chit_months")
}

model ChitAuction {
  id              String        @id @default(uuid())
  chitId          String
  chit            ChitFund      @relation(fields: [chitId], references: [id], onDelete: Cascade)
  monthId         String
  month           ChitMonth     @relation(fields: [monthId], references: [id])
  auctionNumber   Int
  auctionType     AuctionType
  auctionDate     DateTime
  auctionAmount   Decimal       @db.Decimal(15, 2)
  startingBid     Decimal       @db.Decimal(15, 2)
  winningBid      Decimal?      @db.Decimal(15, 2)
  winnerId        String?       // ChitMember.id of the winner
  winner          ChitMember?   @relation("AuctionWinner", fields: [winnerId], references: [id])
  winnerPayout    Decimal?      @db.Decimal(15, 2)
  status          AuctionStatus @default(PENDING)
  createdById     String
  createdBy       User          @relation("ChitAuctionCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  ledger     ChitFundLedger[]
  payout     ChitPayout?
  bids       ChitBid[]

  @@unique([chitId, auctionNumber])
  @@map("chit_auctions")
}

model ChitBid {
  id        String      @id @default(uuid())
  auctionId String
  auction   ChitAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  memberId  String
  bidAmount Decimal     @db.Decimal(15, 2)
  bidTime   DateTime    @default(now())
  status    String      @default("PLACED") // PLACED, WON, LOST
  createdAt DateTime    @default(now())

  @@map("chit_bids")
}

model ChitFundLedger {
  id              String                    @id @default(uuid())
  chitId          String
  chit            ChitFund                  @relation(fields: [chitId], references: [id], onDelete: Cascade)
  auctionId       String?
  auction         ChitAuction?              @relation(fields: [auctionId], references: [id])
  loanId          String?
  loan            ChitLoan?                 @relation(fields: [loanId], references: [id])
  transactionType ChitLedgerTransactionType
  amount          Decimal                   @db.Decimal(15, 2)
  direction       ChitLedgerDirection
  balanceAfter    Decimal                   @db.Decimal(15, 2)
  referenceId     String?
  description     String
  createdById     String
  createdBy       User                      @relation("ChitLedgerCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime                  @default(now())

  @@map("chit_fund_ledger")
}

model ChitLoan {
  id              String         @id @default(uuid())
  chitId          String
  chit            ChitFund       @relation(fields: [chitId], references: [id], onDelete: Cascade)
  memberId        String
  member          ChitMember     @relation(fields: [memberId], references: [id])
  principalAmount Decimal        @db.Decimal(15, 2)
  interestRate    Decimal        @default(3.00) @db.Decimal(5, 2)
  interestAmount  Decimal        @db.Decimal(15, 2)
  totalRepayment  Decimal        @db.Decimal(15, 2)
  amountPaid      Decimal        @default(0) @db.Decimal(15, 2)
  remainingAmount Decimal        @db.Decimal(15, 2)
  loanDate        DateTime
  dueDate         DateTime
  status          ChitLoanStatus @default(ACTIVE)
  createdById     String
  createdBy       User           @relation("ChitLoanCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  transactions ChitLoanTransaction[]
  ledger       ChitFundLedger[]

  @@map("chit_loans")
}

model ChitLoanTransaction {
  id               String   @id @default(uuid())
  loanId           String
  loan             ChitLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transactionType  String   // REPAYMENT, DISBURSEMENT
  principalAmount  Decimal  @db.Decimal(15, 2)
  interestAmount   Decimal  @db.Decimal(15, 2)
  totalAmount      Decimal  @db.Decimal(15, 2)
  paymentReference String?
  transactionDate  DateTime @default(now())
  createdById      String
  createdBy        User     @relation("ChitLoanTxCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())

  @@map("chit_loan_transactions")
}

model ChitMemberPayment {
  id               String                  @id @default(uuid())
  chitId           String
  chit             ChitFund                @relation(fields: [chitId], references: [id], onDelete: Cascade)
  memberId         String
  member           ChitMember              @relation(fields: [memberId], references: [id])
  monthId          String
  month            ChitMonth               @relation(fields: [monthId], references: [id])
  amountDue        Decimal                 @db.Decimal(15, 2)
  amountPaid       Decimal                 @default(0) @db.Decimal(15, 2)
  dueDate          DateTime
  paidDate         DateTime?
  status           ChitMemberPaymentStatus @default(PENDING)
  paymentReference String?
  paymentMethod    String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([memberId, monthId])
  @@map("chit_member_payments")
}

model ChitPayout {
  id               String      @id @default(uuid())
  chitId           String
  chit             ChitFund    @relation(fields: [chitId], references: [id], onDelete: Cascade)
  auctionId        String      @unique
  auction          ChitAuction @relation(fields: [auctionId], references: [id])
  winnerId         String
  winner           ChitMember  @relation(fields: [winnerId], references: [id])
  auctionAmount    Decimal     @db.Decimal(15, 2)
  winningBid       Decimal     @db.Decimal(15, 2)
  payoutAmount     Decimal     @db.Decimal(15, 2)
  status           String      @default("PENDING") // PENDING, PAID
  paymentReference String?
  paidAt           DateTime?
  createdAt        DateTime    @default(now())

  @@map("chit_payouts")
}
