NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ─── Deployment URLs ──────────────────────────────────────────────────────────
# BASE_URL is used for Swagger docs, email links, etc.
BASE_URL=https://your-app-name.onrender.com
# Comma-separated allowed origins — set to your frontend URL in production
CORS_ORIGIN=*

# ─── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get both from https://console.neon.tech → your project → Connection Details
# Use the POOLED URL for DATABASE_URL and DIRECT URL for DIRECT_DATABASE_URL
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_DATABASE_URL="postgresql://USER:PASS@HOST.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')|Write-Host"
JWT_ACCESS_SECRET=<generate-64-char-hex>
JWT_REFRESH_SECRET=<generate-64-char-hex>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Super Admin ──────────────────────────────────────────────────────────────
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=<choose-a-strong-password>

# ─── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# 1. Enable 2FA on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" → copy the 16-char code
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=<16-char-gmail-app-password-no-spaces>
SMTP_FROM="Your App Name <your_email@gmail.com>"

# ─── Firebase (FCM push notifications) ────────────────────────────────────────
# 1. Go to https://console.firebase.google.com → Create Project
# 2. Project Settings → Service Accounts → Generate New Private Key
# 3. Save the JSON file as firebase-service-account.json in the backend folder
# 4. NEVER commit this file to git (it's already in .gitignore)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Cloudinary (KYC documents & receipt PDFs) ────────────────────────────────
# Get from https://console.cloudinary.com/app/settings/api-keys
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ─── SMS ──────────────────────────────────────────────────────────────────────
# Leave as 'none' to use console stub (safe for dev)
# Set to your provider (e.g. msg91, fast2sms, twilio) with credentials below
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

# ─── UPI ──────────────────────────────────────────────────────────────────────
UPI_ID=merchant@upi
UPI_PAYEE_NAME=Finance Company

# ─── Razorpay (optional — configure when ready) ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── Encryption (AES-256-CBC for Aadhaar/PAN at rest) ─────────────────────────
# Generate with: node -e "require('crypto').randomBytes(16).toString('hex')|Write-Host"
# CRITICAL: Never change this key once you have encrypted real data in the DB.
ENCRYPTION_KEY=<generate-32-char-hex>
